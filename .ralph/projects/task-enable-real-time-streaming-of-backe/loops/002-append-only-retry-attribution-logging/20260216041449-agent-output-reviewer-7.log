+use tracing::warn;
+
 pub fn log_path_for_role(project_dir: &Path, loop_number: Option<u32>, role: &str) -> PathBuf {
     let filename = format!("agent-output-{role}.log");
     match loop_number {
@@ -39,9 +42,113 @@ pub fn sanitize_for_filename(label: &str) -> String {
