+pub fn e2e_mock_gh_logging_script() -> String {
+    r###"#!/bin/sh
+set -eu
+
+log_path="${RALPH_E2E_GH_LOG:-${TMPDIR:-/tmp}/ralph-e2e-gh.log}"
+
+if [ $# -ge 2 ] && [ "$1" = "pr" ] && [ "$2" = "create" ]; then
+  : > "$log_path"
+
