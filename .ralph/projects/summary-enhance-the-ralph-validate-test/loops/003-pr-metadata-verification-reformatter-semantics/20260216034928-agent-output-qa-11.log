+        let env_vars = [
+            ("PATH", path_env.as_str()),
+            ("RALPH_DAEMON_BIN", daemon_ralph_bin.as_str()),
+            ("RALPH_E2E_GH_LOG", gh_log_str.as_str()),
+        ];
+
+        let output = h
+            .ralph_env(
+                [
+                    "daemon",
+                    "start",
+                    "--repo",
+                    "acme/widgets",
+                    "--single-iteration",
