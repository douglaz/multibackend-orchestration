+            .write_mock_script(
+                "reformatter-should-not-run.sh",
+                &format!(
+                    "#!/bin/sh\nset -eu\ncat >/dev/null\nprintf 'unexpected reformatter call\\n' >> \"{codex_log_str}\"\nexit 0\n"
+                ),
+            )
