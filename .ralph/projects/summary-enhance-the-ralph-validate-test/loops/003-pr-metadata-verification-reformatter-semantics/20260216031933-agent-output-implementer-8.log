+  fi
+  printf '%s:%s\n' "${RALPH_VALIDATE_BACKEND_LABEL:-backend}" "$kind" >> "${RALPH_VALIDATE_BACKEND_LOG}"
+fi
+
+# Intentionally produce no stdout so orchestrator exercises empty-output handling.
+exit 0
+"###
+    .to_owned()
+}
