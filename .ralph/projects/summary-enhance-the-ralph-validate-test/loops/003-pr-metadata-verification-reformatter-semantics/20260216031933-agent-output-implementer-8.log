+pub fn nonzero_exit_backend_script() -> String {
+    r###"#!/bin/sh
+set -eu
+
+cat >/dev/null
+if [ -n "${RALPH_VALIDATE_BACKEND_LOG:-}" ]; then
+  printf '%s:nonzero\n' "${RALPH_VALIDATE_BACKEND_LABEL:-backend}" >> "${RALPH_VALIDATE_BACKEND_LOG}"
+fi
+echo "intentional backend failure" >&2
+exit 17
+"###
+    .to_owned()
