+            "backends.claude.env.RALPH_VALIDATE_BACKEND_LABEL",
+            "claude",
+        ])
+        .expect("config set claude label failed");
+        h.ralph_ok([
+            "config",
+            "set",
+            "backends.codex.env.RALPH_VALIDATE_BACKEND_LOG",
