+            .expect("setup_separate_mock_backends failed");
+
+        let call_log = h.temp_dir.path().join("backend-call-order.log");
+        let call_log_str = call_log.to_string_lossy().into_owned();
+        h.ralph_ok([
+            "config",
+            "set",
+            "backends.claude.env.RALPH_VALIDATE_BACKEND_LOG",
