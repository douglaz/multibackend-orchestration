+        ])
+        .expect("config set claude label failed");
+        h.ralph_ok([
+            "config",
+            "set",
+            "backends.codex.env.RALPH_VALIDATE_BACKEND_LOG",
+            &call_log_str,
+        ])
+        .expect("config set codex log path failed");
+        h.ralph_ok([
+            "config",
+            "set",
+            "backends.codex.env.RALPH_VALIDATE_BACKEND_LABEL",
