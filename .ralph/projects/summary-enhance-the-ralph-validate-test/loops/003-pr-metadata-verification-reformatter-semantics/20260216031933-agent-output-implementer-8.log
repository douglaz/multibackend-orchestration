+fn parse_logged_args(log_content: &str) -> Vec<String> {
+    log_content
+        .lines()
+        .filter_map(|line| {
+            let rest = line.strip_prefix("arg[")?;
+            let (_, value) = rest.split_once("]=")?;
+            Some(value.to_owned())
+        })
