    for segment in field.split('.') {
        current = current
            .get(segment)
            .unwrap_or_else(|| panic!("missing TOML field segment '{segment}' in '{field}'"));
    }
    assert_eq!(
        current, expected,
        "unexpected value for TOML field '{field}'"
    );
}

